# Mahajan Multispecialist Hospital - Backend Environment Variables
PORT=3000
NODE_ENV=development

# PostgreSQL Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mahajan_hospital
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Alternative single connection URL (e.g. Supabase, Neon, AWS RDS)
# DATABASE_URL=postgresql://user:password@host:5432/mahajan_hospital?sslmode=require

# Frontend CORS Origin
FRONTEND_URL=http://localhost:5173
